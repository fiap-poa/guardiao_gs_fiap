# Copie para backend/.env (ignorado pelo git) e proteja: chmod 600 backend/.env
# Nunca coloque valores neste arquivo.

# my.telegram.org -> API development tools (conta de desenvolvedor do João)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Token do bot criado no @BotFather
TELEGRAM_BOT_TOKEN=

# Google AI Studio (detecção, a partir da história 5)
GEMINI_API_KEY=
# Opcional: outro modelo do Gemini (padrão gemini-3.5-flash-lite)
GEMINI_MODELO=
